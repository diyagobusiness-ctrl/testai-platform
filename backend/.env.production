# Backend Production Environment Variables
# Copy these to Railway → Variables tab

# Database (from Neon)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/testai?sslmode=require

# JWT
JWT_SECRET=your-super-secret-key-change-this

# Server
PORT=5000
NODE_ENV=production

# CORS (your Vercel frontend URL)
FRONTEND_URL=https://testai-platform.vercel.app
